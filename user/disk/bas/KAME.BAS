10 REM KAME - カメのエサあつめ（T88-BASIC のデモ）
20 REM 矢印キーか 8 2 4 6 で動く。* を 10 個食べたら勝ち。# にぶつかると負け。Q で終わり
25 REM SLEEP は T88-BASIC の拡張（ミリ秒の待ち）
30 DEFINT A-Z:RANDOMIZE
40 W=40:H=18:DIM M(W,H)
50 CLS:COLOR 4
60 FOR X=0 TO W:LOCATE X,0:PRINT "#";:LOCATE X,H:PRINT "#";:M(X,0)=1:M(X,H)=1:NEXT
70 FOR Y=0 TO H:LOCATE 0,Y:PRINT "#";:LOCATE W,Y:PRINT "#";:M(0,Y)=1:M(W,Y)=1:NEXT
80 COLOR 2:FOR I=1 TO 25:X=INT(RND(1)*(W-2))+1:Y=INT(RND(1)*(H-2))+1
90 IF X=20 AND Y=9 THEN 110
100 M(X,Y)=1:LOCATE X,Y:PRINT "#";
110 NEXT
120 COLOR 6:FOR I=1 TO 10
130 X=INT(RND(1)*(W-2))+1:Y=INT(RND(1)*(H-2))+1:IF M(X,Y)<>0 OR (X=20 AND Y=9) THEN 130
140 M(X,Y)=2:LOCATE X,Y:PRINT "*";:NEXT
150 PX=20:PY=9:SC=0:DX=1:DY=0:T=0
160 COLOR 7:LOCATE 0,H+1:PRINT "SCORE";SC;"  TIME";T;
170 COLOR 5:LOCATE PX,PY:PRINT "@";
180 K$=INKEY$
190 IF K$=CHR$(30) OR K$="8" THEN DX=0:DY=-1
200 IF K$=CHR$(31) OR K$="2" THEN DX=0:DY=1
210 IF K$=CHR$(29) OR K$="4" THEN DX=-1:DY=0
220 IF K$=CHR$(28) OR K$="6" THEN DX=1:DY=0
230 IF K$="q" OR K$="Q" THEN 400
240 SLEEP 30: REM N88 では FOR D=1 TO 300:NEXT D など
250 T=T+1:IF T MOD 4<>0 THEN 180
260 LOCATE PX,PY:PRINT " ";:PX=PX+DX:PY=PY+DY
270 IF M(PX,PY)=1 THEN 350
280 IF M(PX,PY)=2 THEN M(PX,PY)=0:SC=SC+1:BEEP
290 IF SC=10 THEN 380
300 GOTO 160
350 COLOR 2:LOCATE PX,PY:PRINT "X";:LOCATE 0,H+2:PRINT "ぶつかった！ SCORE";SC
360 GOTO 410
380 COLOR 6:LOCATE 0,H+2:PRINT "ぜんぶ食べた！ TIME";T
390 GOTO 410
400 LOCATE 0,H+2:PRINT "おわり"
410 COLOR 7:END
