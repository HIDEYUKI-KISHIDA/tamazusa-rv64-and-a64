10 ' TEST3.BAS  T88-BASIC の拡張の自己テスト（構造化・ON TIMER・機器・名前の口）
20 NG=0: ESTOP 0
30 ' ---- 複数行の IF・ELSEIF
40 R$="": FOR I=1 TO 4
50 IF I=1 THEN
60   R$=R$+"a"
70 ELSEIF I=2 THEN
80   R$=R$+"b"
90 ELSE
100  IF I=3 THEN R$=R$+"c" ELSE R$=R$+"d"
110 END IF
120 NEXT: CALL CHK("IF ELSEIF ELSE END IF", R$="abcd")
130 ' ---- SELECT CASE
140 R$="": FOR I=1 TO 6
150 SELECT CASE I
160 CASE 1: R$=R$+"1"
170 CASE 2, 3: R$=R$+"2"
180 CASE 4 TO 5: R$=R$+"4"
190 CASE ELSE: R$=R$+"x"
200 END SELECT
210 NEXT: CALL CHK("SELECT CASE", R$="12244x")
220 ' ---- DO LOOP・EXIT
230 N=0: DO: N=N+1: IF N=5 THEN EXIT DO
240 LOOP: DO WHILE N<8: N=N+1: LOOP: DO: N=N+1: LOOP UNTIL N>=10
250 FOR I=1 TO 9: IF I=3 THEN EXIT FOR
260 NEXT: CALL CHK("DO LOOP WHILE UNTIL EXIT", N=10 AND I=3)
270 ' ---- SUB・FUNCTION・LOCAL・再帰
280 X=7: CALL SETX: CALL CHK("SUB FUNCTION LOCAL recursion", FACT(10)=3628800 AND X=7 AND NM$("ab")="[ab]")
290 ' ---- ON TIMER（SLEEP の時間は変わらない）
300 C=0: T0=TIMER: ON TIMER(.1) GOSUB 900: TIMER ON: SLEEP 550: TIMER OFF
310 E=TIMER-T0: CALL CHK("ON TIMER GOSUB, SLEEP keeps its time", C>=4 AND C<=6 AND E>=.5 AND E<.9)
320 ' ---- 仮想の機器
330 OUT &HE000,250: CALL CHK("INP OUT SENSOR", INP(&HE000)=250 AND SENSOR(0)=25)
340 PWM 0,100: SERVO 0,90,180: SLEEP 600
350 CALL CHK("PWM SERVO", PWM(0)=100 AND SERVO(0)=90)
360 ON ERROR GOTO 950: E=0: ESTOP: S1=ESTOP: H1=PWM(0): PWM 0,50: H2=PWM(0): ESTOP 0: ON ERROR GOTO 0
370 CALL CHK("ESTOP (outputs refused while stopped)", S1=1 AND H1=0 AND H2=0 AND E=111 AND ESTOP=0)
380 WATCHDOG 100: PWM 1,60: SLEEP 250: S2=ESTOP: F=PWM(1): ESTOP 0: WATCHDOG 0
390 CALL CHK("WATCHDOG", S2=2 AND F=0)
391 ' ---- 名前の口（/etc/io.conf）
392 PWM "HEATER",40: PIN "LED2",1
393 CALL CHK("named PWM PIN ADC", PWM("HEATER")=40 AND PWM(0)=40 AND PIN("LED2")=1 AND PIN(2)=1 AND ABS(ADC("TEMP")-SENSOR(0))<.2)
394 ON ERROR GOTO 950: E1=0: E2=0: E3=0
395 E=0: SERVO "ARM0",120: E1=E: E=0: SERVO 0,-100: E2=E: E=0: PRINT PWM("NOPE"): E3=E: ON ERROR GOTO 0
396 CALL CHK("io.conf limits (name and number), Device unavailable", E1=5 AND E2=5 AND E3=110)
397 CALL CHK("DEVICE", DEVICE("TEMP")=-1 AND DEVICE("NOPE")=0)
398 PWM "HEATER",0: PIN "LED2",0
400 IF NG=0 THEN PRINT "TEST3 ALL OK" ELSE PRINT "TEST3 NG";NG
410 END
500 SUB CHK(W$, OK)
510   IF OK THEN PRINT "ok  "; W$ ELSE PRINT "NG  "; W$: NG=NG+1
520 END SUB
600 SUB SETX
610   LOCAL X: X=99
620 END SUB
700 FUNCTION FACT(N)
710   IF N<=1 THEN FACT=1 ELSE FACT=N*FACT(N-1)
720 END FUNCTION
800 FUNCTION NM$(A$)
810   NM$="["+A$+"]"
820 END FUNCTION
900 C=C+1: RETURN
950 E=ERR: RESUME NEXT
