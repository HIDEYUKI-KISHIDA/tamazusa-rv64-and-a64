10 REM T88-BASIC self test (stage 2: files and errors)
20 OPEN "T2SEQ.DAT" FOR OUTPUT AS #1
30 PRINT #1, "ABC";12;-3.5
40 WRITE #1, "X,Y", 42, "Z"
50 PRINT #1, USING "##.#";3.14159
60 CLOSE #1
70 OPEN "T2SEQ.DAT" FOR APPEND AS #1:PRINT #1,"LAST":CLOSE
80 OPEN "T2SEQ.DAT" FOR INPUT AS #2
90 LINE INPUT #2, L$:PRINT "line[";L$;"]"
100 INPUT #2, A$, B, C$:PRINT "write[";A$;"]";B;"[";C$;"]"
110 INPUT #2, D:PRINT "using";D
120 LINE INPUT #2, L$:PRINT "append[";L$;"]";
130 PRINT " eof";EOF(2);LOF(2)
140 CLOSE #2
150 OPEN "T2REC.DAT" AS #3 LEN=16
160 FIELD #3, 8 AS N$, 2 AS I$, 4 AS S$, 2 AS P$
170 FOR R=1 TO 3:LSET N$="NAME"+CHR$(48+R):LSET I$=MKI$(R*100):LSET S$=MKS$(R/4):RSET P$="*":PUT #3,R:NEXT
180 GET #3,2:PRINT "rec[";N$;"]";CVI(I$);CVS(S$);"[";P$;"]";LOC(3);LOF(3)
190 CLOSE #3
200 PRINT "mbf";ASC(MID$(MKS$(1),4,1));ASC(MID$(MKS$(1),3,1));CVD(MKD$(1/3#))
210 ON ERROR GOTO 900
220 X=1/0:PRINT "resumed next"
230 OPEN "NOFILE.DAT" FOR INPUT AS #1
240 PRINT "after";E1
250 ERROR 200
260 NAME "T2SEQ.DAT" AS "T2NEW.DAT":KILL "T2NEW.DAT":KILL "T2REC.DAT"
270 OPEN "T2NEW.DAT" FOR INPUT AS #1
280 PRINT "killed ok"
290 ON ERROR GOTO 0
300 PRINT "end"
310 END
900 PRINT "err";ERR;"line";ERL
910 IF ERR=11 THEN RESUME NEXT
920 IF ERR=53 AND ERL=230 THEN E1=1:RESUME 240
925 IF ERR=53 AND ERL=270 THEN RESUME 280
930 IF ERR=200 THEN RESUME NEXT
940 PRINT "unexpected":END
